    a sh:NodeShape ;
    rdfs:isDefinedBy ont: ;
    sh:property
        [
            sh:maxCount 1 ;
            sh:message "Requirement 2.7.2: Each agent MUST indicate at exactly one name property with the schema:name property that must be a text literal value" ;
