    sh:or (
            [
                sh:class tern:FeatureOfInterest
            ]
            [
                sh:class tern:Sample
            ]
            [
                sh:class tern:MaterialSample
            ]
            [
                sh:class tern:Site
            ]
            [
                sh:class tern:Transect
            ]
        ) ;
    sh:path sosa:hasUltimateFeatureOfInterest ;
    sdo:description "Link to the ultimate feature of interest of an observation or act of sampling. This is useful when the proximate feature of interest is a sample of the ultimate feature of interest, directly or transitively." ;
    sdo:name "has ultimate feature of interest" ;
.

