    sh:nodeKind sh:Literal ;
    sh:or (
            [
                sh:datatype xsd:dateTime
            ]
            [
                sh:datatype xsd:date
            ]
        ) ;
    sh:path prov:startedAtTime ;
    sdo:description "The time at which an activity started. `xsd:date` is accepted for activities recorded with a date only." ;
