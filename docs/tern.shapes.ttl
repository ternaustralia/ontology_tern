    sh:or (
            [
                sh:class tern:Observation
            ]
            [
                sh:class tern:Sampling
            ]
        ) ;
    sh:path sosa:isResultOf ;
    sdo:description "Relation linking a Result to the Observation or Actuation or act of Sampling that created or caused it." ;
    sdo:name "is result of" ;
.

