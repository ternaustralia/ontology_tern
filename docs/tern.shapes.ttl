    sh:description "The temporal unit which provides the precision of a date-time value or scale of a temporal extent." ;
    sh:in (
            time:unitDay
            time:unitHour
            time:unitMinute
            time:unitMonth
            time:unitSecond
            time:unitWeek
            time:unitYear
        ) ;
    sh:maxCount 1 ;
    sh:message "A `time:Duration` _MUST_ have exactly 1 `time:unitType` predicate where the value node is an IRI from a controlled list." ;
    sh:minCount 1 ;
    sh:name "time:unitType" ;
    sh:nodeKind sh:IRI ;
    sh:path time:unitType ;
    sdo:description "The temporal unit which provides the precision of a date-time value or scale of a temporal extent." ;
    sdo:name "unit type" ;
.

<urn:shape:Observation-hasFeatureOfInterest>
    a sh:PropertyShape ;
    reg:status reg:statusStable ;
    rdfs:isDefinedBy tern-shapes: ;
    skos:prefLabel "observation has feature of interest" ;
    sh:description "Has at least 1 spatial indicator alongs its chain of samples" ;
    sh:message "An `Observation` _MUST_ have at least one `sosa:hasFeatureOfInterest` predicate where the value node is an IRI of type `tern:FeatureOfInterest` and its subclasses." ;
    sh:name "Observation's sosa:hasFeatureOfInterest" ;
    sh:node <urn:shape:Observation-hasFeatureOfInterest-Sample> ;
    sh:path sosa:hasFeatureOfInterest ;
    sdo:description "Has at least 1 spatial indicator alongs its chain of samples" ;
    sdo:name "observation has feature of interest" ;
.

<urn:shape:Observation-hasFeatureOfInterest-Sample>
    a sh:NodeShape ;
    rdfs:label "Sample node shape of sosa:hasFeatureOfInterest" ;
    rdfs:isDefinedBy tern-shapes: ;
    sh:or (
            <urn:shape:Sample-isSampleOf-spatial>
            <urn:shape:Sample-isSampleOf-sfWithin>
        ) ;
    sdo:description "Requires spatial information along the feature of interest's sample chain." ;
    sdo:name "Sample node shape of sosa:hasFeatureOfInterest" ;
.

<urn:shape:Sample-isSampleOf-sfWithin>
    a sh:PropertyShape ;
    reg:status reg:statusExperimental ;
    rdfs:isDefinedBy tern-shapes: ;
    skos:prefLabel "sample's sosa:isSampleOf sfWithin" ;
    sh:description "At least one geo:sfWithin exists along the chain of sosa:isSampleOf paths." ;
    sh:message "A `tern:Sample` _MUST_ have at least one `sosa:isSampleOf` or `tern:hasSite` predicate with location information." ;
    sh:name "Sample's sosa:isSampleOf" ;
    sh:path [
            sh:zeroOrMorePath [
                    sh:alternativePath (
                            sosa:isSampleOf
                            tern:hasSite
                        )
                ]
        ] ;
    sh:qualifiedMinCount 1 ;
    sh:qualifiedValueShape [
            sh:property <urn:shape:geo-sfWithin-min-1>
        ] ;
    sdo:description "At least one geo:sfWithin exists along the chain of sosa:isSampleOf paths." ;
    sdo:name "sample's sosa:isSampleOf sfWithin" ;
.

<urn:shape:Sample-isSampleOf-spatial>
    a sh:PropertyShape ;
    reg:status reg:statusExperimental ;
    rdfs:isDefinedBy tern-shapes: ;
    skos:prefLabel "sample's sosa:isSampleOf spatial" ;
    sh:description "At least one sdo:spatial, geo:hasGeometry, tern:transectStartPoint, or tern:transectEndPoint exists along the chain of sosa:isSampleOf or tern:hasSite paths." ;
    sh:message "At least one sdo:spatial, geo:hasGeometry, tern:transectStartPoint, or tern:transectEndPoint exists along the chain of sosa:isSampleOf or tern:hasSite paths." ;
    sh:name "Sample's sosa:isSampleOf or tern:hasSite" ;
    sh:path [
            sh:zeroOrMorePath [
                    sh:alternativePath (
                            sosa:isSampleOf
                            tern:hasSite
                        )
                ]
        ] ;
    sh:qualifiedMinCount 1 ;
    sh:qualifiedValueShape [
            sh:or (
                    [
                        sh:property <urn:shape:sdo-spatial-min-1>
                    ]
                    [
                        sh:property <urn:shape:geo-hasGeometry-min-1>
                    ]
                    [
                        sh:property <urn:shape:transectStartPoint-min-1>
                    ]
                    [
                        sh:property <urn:shape:transectEndPoint-min-1>
                    ]
                )
        ] ;
    sdo:description "At least one sdo:spatial, geo:hasGeometry, tern:transectStartPoint, or tern:transectEndPoint exists along the chain of sosa:isSampleOf or tern:hasSite paths." ;
    sdo:name "sample's sosa:isSampleOf spatial" ;
.

<urn:shape:Sampling-hasResult-Site-sdo-spatial>
    a sh:NodeShape ;
    rdfs:label "Sampling has result Site with spatial" ;
    rdfs:isDefinedBy tern-shapes: ;
    sh:property [
            reg:status reg:statusExperimental ;
            rdfs:isDefinedBy tern-shapes: ;
            skos:prefLabel "has result" ;
            sh:description "Sampling results include a `tern:Site` with spatial data." ;
            sh:message "At least 1 `sosa:hasResult` predicate must refer to a `tern:Site` that has `sdo:spatial`." ;
            sh:name "sosa:hasResult" ;
            sh:path sosa:hasResult ;
            sh:qualifiedMinCount 1 ;
            sh:qualifiedValueShape [
                    sh:class tern:Site ;
                    sh:property [
                            rdfs:isDefinedBy tern-shapes: ;
                            skos:prefLabel "spatial" ;
                            sh:description "Site has spatial data." ;
                            sh:message "At least 1 `sdo:spatial` predicate must be present on the `tern:Site`." ;
                            sh:minCount 1 ;
                            sh:name "sdo:spatial" ;
                            sh:path sdo:spatial ;
                            sdo:description "Site has spatial data." ;
                            sdo:name "spatial"
                        ]
                ] ;
            sdo:description "Sampling results include a `tern:Site` with spatial data." ;
            sdo:name "has result"
        ] ;
    sdo:description "Requires a sampling result to be a site with `sdo:spatial`." ;
    sdo:name "Sampling has result Site with spatial" ;
.

