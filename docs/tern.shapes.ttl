# baseURI: https://w3id.org/tern/shapes/tern/
# imports: http://datashapes.org/dash
# imports: http://www.opengis.net/ont/geosparql
# imports: http://www.w3.org/2004/02/skos/core
# imports: http://www.w3.org/ns/shacl#
# imports: https://w3id.org/tern/ontologies/tern/
# prefix: tern-shapes
PREFIX dcat: <http://www.w3.org/ns/dcat#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX dwc: <http://rs.tdwg.org/dwc/terms/>
PREFIX geo: <http://www.opengis.net/ont/geosparql#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX reg: <http://purl.org/linked-data/registry#>
PREFIX sdo: <https://schema.org/>
PREFIX sf: <http://www.opengis.net/ont/sf#>
PREFIX sh: <http://www.w3.org/ns/shacl#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX sosa: <http://www.w3.org/ns/sosa/>
PREFIX ssn: <http://www.w3.org/ns/ssn/>
PREFIX ssn-system: <http://www.w3.org/ns/ssn/systems/>
PREFIX tern: <https://w3id.org/tern/ontologies/tern/>
PREFIX tern-shapes: <https://w3id.org/tern/shapes/tern/>
PREFIX time: <http://www.w3.org/2006/time#>
PREFIX void: <http://rdfs.org/ns/void#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

tern-shapes:Association
    a sh:NodeShape ;
    rdfs:label "Association" ;
    rdfs:isDefinedBy tern-shapes: ;
    sh:property
        tern-shapes:Association-agent ,
        tern-shapes:Association-hadPlan ,
        tern-shapes:Association-hadRole ;
    sh:targetClass prov:Association ;
    sdo:description "An activity association is an assignment of responsibility to an agent for an activity, indicating that the agent had a role in the activity." ;
    sdo:name "Association" ;
.

tern-shapes:Attribute
    a sh:NodeShape ;
    rdfs:label "Attribute" ;
    rdfs:isDefinedBy tern-shapes: ;
    sh:property
        tern-shapes:dcterms-type ,
        tern-shapes:tern-attribute ,
        tern-shapes:tern-hasAttribute ,
        tern-shapes:tern-hasSimpleValue ,
        tern-shapes:tern-hasValue ,
        tern-shapes:tern-isAttributeOf ,
        tern-shapes:void-inDataset ;
    sh:targetClass tern:Attribute ;
    sdo:description "A property-value pair to capture attributes of an individual where observations are not suitable." ;
    sdo:name "Attribute" ;
.

tern-shapes:Attribution
    a sh:NodeShape ;
    rdfs:label "Attribution" ;
    rdfs:isDefinedBy tern-shapes: ;
    sh:property
        tern-shapes:Attribution-agent ,
        tern-shapes:Attribution-hadRole ;
    sh:targetClass prov:Attribution ;
    sdo:description "Attribution is the ascribing of an entity to an agent. When an entity `e` is attributed to agent `ag`, entity `e` was generated by some unspecified activity that in turn was associated to agent `ag`. Thus, this relation is useful when the activity is not known, or irrelevant." ;
    sdo:name "Attribution" ;
.

tern-shapes:Boolean
    a sh:NodeShape ;
    rdfs:label "Boolean" ;
    reg:status reg:statusStable ;
    rdfs:isDefinedBy tern-shapes: ;
    sh:property tern-shapes:Boolean-value ;
    sh:targetClass tern:Boolean ;
    sdo:description "Class to encapsulate a true-or-false value." ;
    sdo:name "Boolean" ;
.

tern-shapes:Calibration
    a sh:NodeShape ;
    rdfs:label "Calibration" ;
    rdfs:isDefinedBy tern-shapes: ;
    sh:property
        tern-shapes:dcterms-description ,
        tern-shapes:prov-endedAtTime ,
        tern-shapes:prov-startedAtTime ,
        tern-shapes:sosa-usedProcedure ,
        tern-shapes:tern-calibratedBy ,
        tern-shapes:tern-calibratesProperty ,
        tern-shapes:tern-calibrationActualResult ,
        tern-shapes:tern-calibrationOffset ,
        tern-shapes:tern-calibrationReferenceResult ,
        tern-shapes:tern-verifiesCapability ;
    sh:targetClass tern:Calibration ;
    sdo:description "An activity to calibrate properties of a System (such as a Sensor or Sampler) to ensure accurate measurements and proper functioning of the device."@en ;
    sdo:name "Calibration" ;
.

tern-shapes:Dataset
    a sh:NodeShape ;
    rdfs:label "Dataset" ;
    rdfs:isDefinedBy tern-shapes: ;
    sh:property [
            a sh:PropertyShape ;
            reg:status reg:statusExperimental ;
            rdfs:isDefinedBy tern-shapes: ;
            skos:prefLabel "dataset distribution" ;
            sh:class tern:Distribution ;
            sh:description "An available distribution of the dataset." ;
            sh:message "A `tern:Dataset` _MAY_ have a `dcat:distribution` predicate with a value of type `tern:Distribution`." ;
            sh:name "dcat:distribution" ;
            sh:nodeKind sh:IRI ;
            sh:path dcat:distribution ;
            sdo:description "An available distribution of the dataset." ;
            sdo:name "dataset distribution"
        ] ;
    sdo:description "A collection of data, published or curated by a single agent, and available for access or download in one or more representations." ;
    sdo:name "Dataset" ;
.

tern-shapes:Date
    a sh:NodeShape ;
    rdfs:label "Date" ;
    rdfs:isDefinedBy tern-shapes: ;
    sh:property tern-shapes:Date-value ;
    sh:targetClass tern:Date ;
    sdo:description "A class to encapsulate an `xsd:date` value." ;
    sdo:name "Date" ;
.

tern-shapes:DateTime
    a sh:NodeShape ;
    rdfs:label "Date time" ;
    rdfs:isDefinedBy tern-shapes: ;
    sh:property tern-shapes:DateTime-value ;
    sh:targetClass tern:DateTime ;
    sdo:description "A class to encapsulate an `xsd:dateTime` value." ;
    sdo:name "Date time" ;
.

tern-shapes:Deployment
    a sh:NodeShape ;
    rdfs:label "Deployment" ;
    rdfs:isDefinedBy tern-shapes: ;
    sh:property
        tern-shapes:Deployment-usedProcedure ,
        tern-shapes:dcterms-identifier ,
        tern-shapes:geo-hasGeometry ,
        tern-shapes:prov-endedAtTime ,
        tern-shapes:prov-startedAtTime ,
        tern-shapes:prov-wasAssociatedWith ,
        tern-shapes:sdo-spatial ,
        tern-shapes:ssn-deployedOnPlatform ,
        tern-shapes:ssn-deployedSystem ,
        tern-shapes:tern-hasAttribute ;
    sh:targetClass tern:Deployment ;
    sdo:description "Describes the Deployment of one or more Systems for a particular purpose. Deployment may be done on a Platform."@en ;
    sdo:name "Deployment" ;
.

tern-shapes:DigitalCamera
    a sh:NodeShape ;
    rdfs:label "Digital Camera" ;
    reg:status reg:statusStable ;
    rdfs:isDefinedBy tern-shapes: ;
    sh:property
        [
            a sh:PropertyShape ;
            reg:status reg:statusExperimental ;
            rdfs:isDefinedBy tern-shapes: ;
            skos:prefLabel "digital camera model" ;
            sh:description "The model as defined by the manufacturer." ;
            sh:message "A `tern:DigitalCamera` _MUST_ have at least 1 `schema:model` predicate." ;
            sh:minCount 1 ;
            sh:name "schema:model" ;
            sh:path <http://schema.org/model> ;
            sdo:description "The model as defined by the manufacturer." ;
            sdo:name "digital camera model"
        ] ,
        [
            a sh:PropertyShape ;
            reg:status reg:statusExperimental ;
            rdfs:isDefinedBy tern-shapes: ;
            skos:prefLabel "digital camera preferred label" ;
            sh:description "The preferred label for the digital camera." ;
            sh:message "A `tern:DigitalCamera` _MUST_ have at least 1 `skos:prefLabel` predicate." ;
            sh:minCount 1 ;
            sh:name "skos:prefLabel" ;
            sh:path skos:prefLabel ;
            sdo:description "The preferred label for the digital camera." ;
            sdo:name "digital camera preferred label"
        ] ,
        [
            a sh:PropertyShape ;
            reg:status reg:statusExperimental ;
            rdfs:isDefinedBy tern-shapes: ;
            skos:prefLabel "digital camera source" ;
            sh:datatype xsd:string ;
            sh:description "The source of information about the digital camera." ;
            sh:message "A `tern:DigitalCamera` _MUST_ have at least 1 `dcterms:source` predicate with a string value." ;
            sh:minCount 1 ;
            sh:name "dcterms:source" ;
            sh:path dcterms:source ;
            sdo:description "The source of information about the digital camera." ;
            sdo:name "digital camera source"
        ] ,
        [
            a sh:PropertyShape ;
            reg:status reg:statusExperimental ;
            rdfs:isDefinedBy tern-shapes: ;
            skos:prefLabel "digital camera manufacturer" ;
            sh:datatype xsd:string ;
            sh:description "The manufacturer of the digital camera." ;
            sh:message "A `tern:DigitalCamera` _MUST_ have at least 1 `schema:manufacturer` predicate with a string value." ;
            sh:minCount 1 ;
            sh:name "schema:manufacturer" ;
            sh:path <http://schema.org/manufacturer> ;
            sdo:description "The manufacturer of the digital camera." ;
            sdo:name "digital camera manufacturer"
        ] ,
        [
            a sh:PropertyShape ;
            reg:status reg:statusExperimental ;
            rdfs:isDefinedBy tern-shapes: ;
            skos:prefLabel "digital camera alternative label" ;
            sh:datatype xsd:string ;
            sh:description "Alternative labels for the digital camera." ;
            sh:message "If present, `skos:altLabel` predicates on a `tern:DigitalCamera` _MUST_ have string values." ;
            sh:name "skos:altLabel" ;
            sh:path skos:altLabel ;
            sdo:description "Alternative labels for the digital camera." ;
            sdo:name "digital camera alternative label"
        ] ,
        [
            a sh:PropertyShape ;
            reg:status reg:statusExperimental ;
            rdfs:isDefinedBy tern-shapes: ;
            skos:prefLabel "digital camera definition" ;
            sh:datatype xsd:string ;
            sh:description "The definition of the digital camera." ;
            sh:message "If present, `skos:definition` predicates on a `tern:DigitalCamera` _MUST_ have string values." ;
            sh:name "skos:definition" ;
            sh:path skos:definition ;
            sdo:description "The definition of the digital camera." ;
            sdo:name "digital camera definition"
        ] ;
    sh:targetClass tern:DigitalCamera ;
    sdo:description "The model as defined by the manufacturer." ;
    sdo:name "Digital Camera" ;
.

tern-shapes:Dimension
    a sh:NodeShape ;
    rdfs:label "Dimension" ;
    reg:status reg:statusStable ;
    rdfs:isDefinedBy tern-shapes: ;
    sh:property
        [
            a sh:PropertyShape ;
            reg:status reg:statusExperimental ;
            rdfs:isDefinedBy tern-shapes: ;
            skos:prefLabel "diemnsion width" ;
            sh:description "The width dimension." ;
            sh:maxCount 1 ;
            sh:message "A `tern:Dimension` _MUST_ have exactly 1 `tern:width` predicate with a double or integer value." ;
            sh:minCount 1 ;
            sh:name "tern:width" ;
            sh:or (
                    [
                        sh:datatype xsd:double
                    ]
                    [
                        sh:datatype xsd:integer
                    ]
                ) ;
            sh:path tern:width ;
            sdo:description "The width dimension." ;
            sdo:name "diemnsion width"
        ] ,
        [
            a sh:PropertyShape ;
            reg:status reg:statusExperimental ;
            rdfs:isDefinedBy tern-shapes: ;
            skos:prefLabel "dimension unit" ;
            sh:class qudt:Unit ;
            sh:description "The unit of measurement for the dimensions." ;
            sh:maxCount 1 ;
            sh:message "A `tern:Dimension` _MUST_ have exactly 1 `tern:unit` predicate with a value of type `qudt:Unit`." ;
            sh:minCount 1 ;
            sh:name "tern:unit" ;
            sh:path tern:unit ;
            sdo:description "The unit of measurement for the dimensions." ;
            sdo:name "dimension unit"
        ] ,
        [
            a sh:PropertyShape ;
            reg:status reg:statusExperimental ;
            rdfs:isDefinedBy tern-shapes: ;
            skos:prefLabel "dimension length" ;
            sh:description "The length dimension." ;
            sh:maxCount 1 ;
            sh:message "A `tern:Dimension` _MUST_ have exactly 1 `tern:length` predicate with a double or integer value." ;
            sh:minCount 1 ;
            sh:name "tern:length" ;
            sh:or (
                    [
                        sh:datatype xsd:double
                    ]
                    [
                        sh:datatype xsd:integer
                    ]
                ) ;
            sh:path tern:length ;
            sdo:description "The length dimension." ;
            sdo:name "dimension length"
        ] ;
    sh:targetClass tern:Dimension ;
    sdo:description "The dimension of a 2D square or rectangular feature. Example, the dimension of a rectangular plot Site. This class should perhaps have specialised classes to express not just square or rectangular features but also others such as circular features." ;
    sdo:name "Dimension" ;
.

tern-shapes:Distribution
    a sh:NodeShape ;
    rdfs:label "Distribution" ;
    rdfs:isDefinedBy tern-shapes: ;
    sdo:description "A specific representation of a dataset. A dataset might be available in multiple serializations that may differ in various ways, including natural language, media-type or format, schematic organization, temporal and spatial resolution, level of detail or profiles (which might specify any or all of the above)." ;
    sdo:name "Distribution" ;
.

tern-shapes:Duration
    a sh:NodeShape ;
    rdfs:label "Duration" ;
    rdfs:isDefinedBy tern-shapes: ;
    sh:property
        tern-shapes:time-numericDuration ,
        tern-shapes:time-unitType ;
    sh:targetClass time:Duration ;
    sdo:description "Duration of a temporal extent expressed as a number scaled by a temporal unit" ;
    sdo:name "Duration" ;
.

tern-shapes:FeatureOfInterest
    a sh:NodeShape ;
    rdfs:label "Feature of Interest" ;
    rdfs:isDefinedBy tern-shapes: ;
    sh:property
        tern-shapes:FeatureOfInterest-featureType ,
        tern-shapes:dcterms-identifier ,
        tern-shapes:dcterms-type ,
        tern-shapes:geo-hasGeometry ,
        tern-shapes:prov-qualifiedAttribution ,
        tern-shapes:prov-wasAttributedTo ,
        tern-shapes:rdfs-comment ,
        tern-shapes:sdo-spatial ,
        tern-shapes:sosa-hasSample ,
        tern-shapes:sosa-isFeatureOfInterestOf ,
        tern-shapes:sosa-isSampleOf ,
        tern-shapes:tern-hasAttribute ,
        tern-shapes:tern-hasSite ,
        tern-shapes:void-inDataset ;
    sh:targetClass tern:FeatureOfInterest ;
    sdo:description "The thing whose property is being estimated or calculated in the course of an Observation to arrive at a Result or whose property is being manipulated by an Actuator, or which is being sampled or transformed in an act of Sampling."@en ;
    sdo:name "Feature of Interest" ;
.

tern-shapes:Float
    a sh:NodeShape ;
    rdfs:label "Float" ;
    rdfs:isDefinedBy tern-shapes: ;
    sh:property
        tern-shapes:Float-uncertainty ,
        tern-shapes:Float-value ,
        tern-shapes:tern-unit ;
    sh:targetClass tern:Float ;
    sdo:description "A class to encapsulate a float." ;
    sdo:name "Float" ;
.

tern-shapes:FluxTower
    a sh:NodeShape ;
    rdfs:label "Flux Tower" ;
    reg:status reg:statusStable ;
    rdfs:isDefinedBy tern-shapes: ;
    sh:property
        [
            a sh:PropertyShape ;
            reg:status reg:statusStable ;
            rdfs:isDefinedBy tern-shapes: ;
            skos:prefLabel "flux tower ozflux ID" ;
            sh:datatype xsd:string ;
            sh:description "The OzFlux ID of the flux tower." ;
            sh:maxCount 1 ;
            sh:message "A `tern:FluxTower` _MAY_ have at most 1 `tern:ozfluxID` predicate with a string value." ;
            sh:name "tern:ozfluxID" ;
            sh:path tern:ozfluxID ;
            sdo:description "The OzFlux ID of the flux tower." ;
            sdo:name "flux tower ozflux ID"
        ] ,
        [
            a sh:PropertyShape ;
            reg:status reg:statusStable ;
            rdfs:isDefinedBy tern-shapes: ;
            skos:prefLabel "flux tower IGBP code" ;
            sh:datatype xsd:string ;
            sh:description "The IGBP code of the flux tower." ;
            sh:maxCount 1 ;
            sh:message "A `tern:FluxTower` _MAY_ have at most 1 `tern:igbpCode` predicate with a string value." ;
            sh:name "tern:igbpCode" ;
            sh:path tern:igbpCode ;
            sdo:description "The IGBP code of the flux tower." ;
            sdo:name "flux tower IGBP code"
        ] ,
        [
            a sh:PropertyShape ;
            reg:status reg:statusStable ;
            rdfs:isDefinedBy tern-shapes: ;
            skos:prefLabel "flux tower description" ;
            sh:datatype xsd:string ;
            sh:description "The description of the flux tower." ;
            sh:message "If present, `dcterms:description` predicates on a `tern:FluxTower` _MUST_ have string values." ;
            sh:name "dcterms:description" ;
            sh:path dcterms:description ;
            sdo:description "The description of the flux tower." ;
            sdo:name "flux tower description"
        ] ,
        [
            a sh:PropertyShape ;
            reg:status reg:statusStable ;
            rdfs:isDefinedBy tern-shapes: ;
            skos:prefLabel "flux tower comment" ;
            sh:datatype xsd:string ;
            sh:description "Comments about the flux tower." ;
            sh:message "If present, `rdfs:comment` predicates on a `tern:FluxTower` _MUST_ have string values." ;
            sh:name "rdfs:comment" ;
            sh:path rdfs:comment ;
            sdo:description "Comments about the flux tower." ;
            sdo:name "flux tower comment"
        ] ,
        [
            a sh:PropertyShape ;
            reg:status reg:statusStable ;
            rdfs:isDefinedBy tern-shapes: ;
            skos:prefLabel "decommissioned date of flux tower" ;
            sh:datatype xsd:date ;
            sh:description "The date when the flux tower was decommissioned." ;
            sh:maxCount 1 ;
            sh:message "A `tern:FluxTower` _MAY_ have at most 1 `tern:dateDecommissioned` predicate with a date value." ;
            sh:name "tern:dateDecommissioned" ;
            sh:path tern:dateDecommissioned ;
            sdo:description "The date when the flux tower was decommissioned." ;
            sdo:name "decommissioned date of flux tower"
        ] ,
        [
            a sh:PropertyShape ;
            reg:status reg:statusStable ;
            rdfs:isDefinedBy tern-shapes: ;
            skos:prefLabel "flux tower fluxnet ID" ;
            sh:datatype xsd:string ;
            sh:description "The FLUXNET ID of the flux tower." ;
            sh:maxCount 1 ;
            sh:message "A `tern:FluxTower` _MAY_ have at most 1 `tern:fluxnetID` predicate with a string value." ;
            sh:name "tern:fluxnetID" ;
            sh:path tern:fluxnetID ;
            sdo:description "The FLUXNET ID of the flux tower." ;
            sdo:name "flux tower fluxnet ID"
        ] ,
        [
            a sh:PropertyShape ;
            reg:status reg:statusStable ;
            rdfs:isDefinedBy tern-shapes: ;
            skos:prefLabel "flux tower is hosted by" ;
            sh:class tern:Site ;
            sh:description "The site that hosts the flux tower." ;
            sh:maxCount 1 ;
            sh:message "A `tern:FluxTower` _MAY_ have at most 1 `sosa:isHostedBy` predicate with a value of type `tern:Site`." ;
            sh:name "sosa:isHostedBy" ;
            sh:path sosa:isHostedBy ;
            sdo:description "The site that hosts the flux tower." ;
            sdo:name "flux tower is hosted by"
        ] ,
        [
            a sh:PropertyShape ;
            reg:status reg:statusStable ;
            rdfs:isDefinedBy tern-shapes: ;
            skos:prefLabel "flux tower purpose" ;
            sh:datatype xsd:string ;
            sh:description "The purpose of the flux tower." ;
            sh:maxCount 1 ;
            sh:message "A `tern:FluxTower` _MAY_ have at most 1 `tern:purpose` predicate with a string value." ;
            sh:name "tern:purpose" ;
            sh:path tern:purpose ;
            sdo:description "The purpose of the flux tower." ;
            sdo:name "flux tower purpose"
        ] ,
        [
            a sh:PropertyShape ;
            reg:status reg:statusExperimental ;
            rdfs:isDefinedBy tern-shapes: ;
            skos:prefLabel "flux tower centroid point" ;
            sh:class sf:Point ;
            sh:description "The centroid point of the flux tower." ;
            sh:maxCount 1 ;
            sh:message "A `tern:FluxTower` _MUST_ have exactly 1 `tern:centroidPoint` predicate with a value of type `sf:Point`." ;
            sh:minCount 1 ;
            sh:name "tern:centroidPoint" ;
            sh:path tern:centroidPoint ;
            sdo:description "The centroid point of the flux tower." ;
            sdo:name "flux tower centroid point"
        ] ,
        [
            a sh:PropertyShape ;
            reg:status reg:statusStable ;
            rdfs:isDefinedBy tern-shapes: ;
            skos:prefLabel "commissioned date of flux tower" ;
            sh:datatype xsd:date ;
            sh:description "The date when the flux tower was commissioned." ;
            sh:maxCount 1 ;
            sh:message "A `tern:FluxTower` _MUST_ have exactly 1 `tern:dateCommissioned` predicate with a date value." ;
            sh:minCount 1 ;
            sh:name "tern:dateCommissioned" ;
            sh:path tern:dateCommissioned ;
            sdo:description "The date when the flux tower was commissioned." ;
            sdo:name "commissioned date of flux tower"
        ] ,
        [
            a sh:PropertyShape ;
            reg:status reg:statusStable ;
            rdfs:isDefinedBy tern-shapes: ;
            skos:prefLabel "flux tower label" ;
            sh:datatype xsd:string ;
            sh:description "The label of the flux tower." ;
            sh:maxCount 1 ;
            sh:message "A `tern:FluxTower` _MUST_ have exactly 1 `rdfs:label` predicate with a string value." ;
            sh:minCount 1 ;
            sh:name "rdfs:label" ;
            sh:path rdfs:label ;
            sdo:description "The label of the flux tower." ;
            sdo:name "flux tower label"
        ] ;
    sh:targetClass tern:FluxTower ;
    sdo:description "Across the globe, towers stand among the landscape, with sensors monitoring these eddies for carbon dioxide, water vapor and other gasses.  These so-called flux towers collect data on carbon dioxide exchange rates between the earth and atmosphere." ;
    sdo:name "Flux Tower" ;
.

tern-shapes:IGSN
    a sh:NodeShape ;
    rdfs:label "IGSN" ;
    rdfs:isDefinedBy tern-shapes: ;
    sh:property
        tern-shapes:IGSN-hasGeometry ,
        tern-shapes:IGSN-hasPart ,
        tern-shapes:IGSN-isPartOf ,
        tern-shapes:IGSN-publisher ,
        tern-shapes:IGSN-relation ,
        tern-shapes:tern-sampleSubType ,
        tern-shapes:tern-sampleType ;
    sh:targetClass tern:IGSN ;
    sdo:description "A globally unique identifier assigned to physical samples to enable traceability, citation, and reuse in scientific research, adhering to FAIR data principles." ;
    sdo:name "IGSN" ;
.

tern-shapes:IRI
    a sh:NodeShape ;
    rdfs:label "IRI" ;
    rdfs:isDefinedBy tern-shapes: ;
    sh:property tern-shapes:IRI-value ;
    sh:targetClass tern:IRI ;
    sdo:description "A class to encapsulate an IRI value." ;
    sdo:name "IRI" ;
.

tern-shapes:Input
    a sh:NodeShape ;
    rdfs:label "Input" ;
    reg:status reg:statusStable ;
    rdfs:isDefinedBy tern-shapes: ;
    sh:property
        [
            a sh:PropertyShape ;
            reg:status reg:statusExperimental ;
            rdfs:isDefinedBy tern-shapes: ;
            skos:prefLabel "input description" ;
            sh:datatype xsd:string ;
            sh:description "The description of the input." ;
            sh:message "If present, `dcterms:description` predicates on a `tern:Input` _MUST_ have string values." ;
            sh:name "dcterms:description" ;
            sh:path dcterms:description ;
            sdo:description "The description of the input." ;
            sdo:name "input description"
        ] ,
        [
            a sh:PropertyShape ;
            reg:status reg:statusExperimental ;
            rdfs:isDefinedBy tern-shapes: ;
            skos:prefLabel "input value" ;
            sh:description "The value of the input." ;
            sh:maxCount 1 ;
            sh:message "A `tern:Input` _MAY_ have at most 1 `rdf:value` predicate." ;
            sh:name "rdf:value" ;
            sh:path rdf:value ;
            sdo:description "The value of the input." ;
            sdo:name "input value"
        ] ,
        [
            a sh:PropertyShape ;
            reg:status reg:statusExperimental ;
            rdfs:isDefinedBy tern-shapes: ;
            skos:prefLabel "input label" ;
            sh:datatype xsd:string ;
            sh:description "The label of the input." ;
            sh:maxCount 1 ;
            sh:message "A `tern:Input` _MUST_ have exactly 1 `rdfs:label` predicate with a string value." ;
            sh:minCount 1 ;
            sh:name "rdfs:label" ;
            sh:path rdfs:label ;
            sdo:description "The label of the input." ;
            sdo:name "input label"
        ] ,
        tern-shapes:tern-hasAttribute ,
        tern-shapes:void-inDataset ;
    sh:targetClass tern:Input ;
    sdo:description "*Input* - Any information that is provided to a Procedure for its use." ;
    sdo:name "Input" ;
.

tern-shapes:Instant
    a sh:NodeShape ;
    rdfs:label "Instant" ;
    rdfs:isDefinedBy tern-shapes: ;
    sh:message "One or more of [`time:inXSDDate`, `time:inXSDDateTimeStamp`, `time:inXSDgYear`, `time:inXSDgYearMonth`, `time:inTimePosition`, and `time:inDateTime`] _MUST_ be present." ;
    sh:or (
            [
                sh:property [
                        rdfs:isDefinedBy tern-shapes: ;
                        skos:prefLabel "in date-time" ;
                        sh:description "Presence of `time:inDateTime`." ;
                        sh:message "At least 1 `time:inDateTime` predicate must be present." ;
                        sh:minCount 1 ;
                        sh:name "time:inDateTime" ;
                        sh:path time:inDateTime ;
                        sdo:description "Presence of `time:inDateTime`." ;
                        sdo:name "in date-time"
                    ]
            ]
            [
                sh:property [
                        rdfs:isDefinedBy tern-shapes: ;
                        skos:prefLabel "in time position" ;
                        sh:description "Presence of `time:inTimePosition`." ;
                        sh:message "At least 1 `time:inTimePosition` predicate must be present." ;
                        sh:minCount 1 ;
                        sh:name "time:inTimePosition" ;
                        sh:path time:inTimePosition ;
                        sdo:description "Presence of `time:inTimePosition`." ;
                        sdo:name "in time position"
                    ]
            ]
            [
                sh:property [
                        rdfs:isDefinedBy tern-shapes: ;
                        skos:prefLabel "in XSD date" ;
                        sh:description "Presence of `time:inXSDDate`." ;
                        sh:message "At least 1 `time:inXSDDate` predicate must be present." ;
                        sh:minCount 1 ;
                        sh:name "time:inXSDDate" ;
                        sh:path time:inXSDDate ;
                        sdo:description "Presence of `time:inXSDDate`." ;
                        sdo:name "in XSD date"
                    ]
            ]
            [
                sh:property [
                        rdfs:isDefinedBy tern-shapes: ;
                        skos:prefLabel "in XSD date-time-stamp" ;
                        sh:description "Presence of `time:inXSDDateTimeStamp`." ;
                        sh:message "At least 1 `time:inXSDDateTimeStamp` predicate must be present." ;
                        sh:minCount 1 ;
                        sh:name "time:inXSDDateTimeStamp" ;
                        sh:path time:inXSDDateTimeStamp ;
                        sdo:description "Presence of `time:inXSDDateTimeStamp`." ;
                        sdo:name "in XSD date-time-stamp"
                    ]
            ]
            [
                sh:property [
                        rdfs:isDefinedBy tern-shapes: ;
                        skos:prefLabel "in XSD g-year" ;
                        sh:description "Presence of `time:inXSDgYear`." ;
                        sh:message "At least 1 `time:inXSDgYear` predicate must be present." ;
                        sh:minCount 1 ;
                        sh:name "time:inXSDgYear" ;
                        sh:path time:inXSDgYear ;
                        sdo:description "Presence of `time:inXSDgYear`." ;
                        sdo:name "in XSD g-year"
                    ]
            ]
            [
                sh:property [
                        rdfs:isDefinedBy tern-shapes: ;
                        skos:prefLabel "in XSD g-year-month" ;
                        sh:description "Presence of `time:inXSDgYearMonth`." ;
                        sh:message "At least 1 `time:inXSDgYearMonth` predicate must be present." ;
                        sh:minCount 1 ;
                        sh:name "time:inXSDgYearMonth" ;
                        sh:path time:inXSDgYearMonth ;
                        sdo:description "Presence of `time:inXSDgYearMonth`." ;
                        sdo:name "in XSD g-year-month"
                    ]
            ]
        ) ;
    sh:property
        tern-shapes:time-Instant-inDateTime ,
        tern-shapes:time-inTimePosition ,
        tern-shapes:time-inXSDDate ,
        tern-shapes:time-inXSDDateTimeStamp ,
        tern-shapes:time-inXSDgYear ,
        tern-shapes:time-inXSDgYearMonth ;
    sh:targetClass time:Instant ;
    sdo:description "A temporal entity with zero extent or duration." ;
    sdo:name "Instant" ;
.

tern-shapes:Integer
    a sh:NodeShape ;
    rdfs:label "Integer" ;
    rdfs:isDefinedBy tern-shapes: ;
    sh:property
        tern-shapes:Integer-uncertainty ,
        tern-shapes:Integer-value ,
        tern-shapes:tern-unit ;
    sh:targetClass tern:Integer ;
    sdo:description "A class to encapsulate an integer value." ;
    sdo:name "Integer" ;
.

tern-shapes:Interval
    a sh:NodeShape ;
    rdfs:label "Interval" ;
    rdfs:isDefinedBy tern-shapes: ;
    sh:property
        tern-shapes:time-hasBeginning ,
        tern-shapes:time-hasDuration ,
        tern-shapes:time-hasEnd ;
    sh:targetClass time:Interval ;
    sdo:description "A temporal entity with an extent or duration." ;
    sdo:name "Interval" ;
.

tern-shapes:Intervention
    a sh:NodeShape ;
    rdfs:label "Intervention" ;
    rdfs:isDefinedBy tern-shapes: ;
    sh:property
        tern-shapes:dcterms-identifier ,
        tern-shapes:dcterms-type ,
        tern-shapes:geo-hasGeometry ,
        tern-shapes:prov-endedAtTime ,
        tern-shapes:prov-qualifiedAssociation ,
        tern-shapes:prov-startedAtTime ,
        tern-shapes:prov-wasAssociatedWith ,
        tern-shapes:sdo-spatial ,
        tern-shapes:sosa-hasFeatureOfInterest ,
        tern-shapes:sosa-usedProcedure ,
        tern-shapes:tern-hasAttribute ,
        tern-shapes:tern-interventionType ,
        tern-shapes:void-inDataset ;
    sh:targetClass tern:Intervention ;
    sdo:description "An `Intervention` is a human-induced activity that carries out a `Procedure` to observe or change the properties of a `Feature Of Interest`." ;
    sdo:name "Intervention" ;
.

tern-shapes:ManagedFeature
    a sh:NodeShape ;
    rdfs:label "Feature which is managed for TERN purposes" ;
    rdfs:isDefinedBy tern-shapes: ;
    sh:property
        tern-shapes:tern-dateCommissioned ,
        tern-shapes:tern-dateDecommissioned ;
    sdo:description "A feature managed for TERN purposes." ;
    sdo:name "Feature which is managed for TERN purposes" ;
.

tern-shapes:MaterialSample
    a sh:NodeShape ;
    rdfs:label "Material sample" ;
    rdfs:isDefinedBy tern-shapes: ;
    sh:property
        tern-shapes:MaterialSample-featureType ,
        tern-shapes:MaterialSample-isSampleOf ,
        tern-shapes:dwc-materialSampleID ,
        tern-shapes:geo-hasGeometry ,
        tern-shapes:tern-hasAttribute ,
        tern-shapes:tern-hasIGSN ,
        tern-shapes:tern-isSubSampleOf ;
    sh:targetClass tern:MaterialSample ;
    sdo:description "A physical result of a sampling (or subsampling) event. In biological collections, the material sample is typically collected, and either preserved or destructively processed." ;
    sdo:name "Material sample" ;
.

tern-shapes:MeasurementRange
    a sh:NodeShape ;
    rdfs:label "Measurement Range" ;
    rdfs:isDefinedBy tern-shapes: ;
    sh:property
        tern-shapes:qudt-maxExclusive ,
        tern-shapes:qudt-maxInclusive ,
        tern-shapes:qudt-minExclusive ,
        tern-shapes:qudt-minInclusive ,
        tern-shapes:tern-unit ;
    sh:targetClass tern:MeasurementRange ;
    sdo:description "The set of values that the Sensor can return as the Result of an Observation under the defined Conditions with the defined system properties."@en ;
    sdo:name "Measurement Range" ;
.

tern-shapes:Method
    a sh:NodeShape ;
    rdfs:label "Method" ;
    reg:status reg:statusStable ;
    rdfs:isDefinedBy tern-shapes: ;
    sh:property
        [
            a sh:PropertyShape ;
            reg:status reg:statusExperimental ;
            rdfs:isDefinedBy tern-shapes: ;
            skos:prefLabel "method required duration" ;
            sh:description "The time required for the method." ;
            sh:maxCount 1 ;
            sh:message "A `tern:Method` _MAY_ have at most 1 `schema:timeRequired` predicate with a string or duration value." ;
            sh:name "schema:timeRequired" ;
            sh:or (
                    [
                        sh:nodeKind sh:Literal
                    ]
                    [
                        sh:datatype xsd:duration
                    ]
                ) ;
            sh:path <http://schema.org/timeRequired> ;
            sdo:description "The time required for the method." ;
            sdo:name "method required duration"
        ] ,
        [
            a sh:PropertyShape ;
            reg:status reg:statusStable ;
            rdfs:isDefinedBy tern-shapes: ;
            skos:prefLabel "note of method" ;
            sh:description "Notes about the method." ;
            sh:message "If present, `skos:note` predicates on a `tern:Method` _MUST_ have string values." ;
            sh:name "skos:note" ;
            sh:nodeKind sh:Literal ;
            sh:path skos:note ;
            sdo:description "Notes about the method." ;
            sdo:name "note of method"
        ] ,
        [
            a sh:PropertyShape ;
            reg:status reg:statusExperimental ;
            rdfs:isDefinedBy tern-shapes: ;
            skos:prefLabel "categorial collection of method" ;
            sh:class skos:Collection ;
            sh:description "The categorical collection of the method." ;
            sh:message "If present, `tern:hasCategoricalCollection` predicates on a `tern:Method` _MUST_ have values of type `skos:Collection`." ;
            sh:name "tern:hasCategoricalCollection" ;
            sh:path tern:hasCategoricalCollection ;
            sdo:description "The categorical collection of the method." ;
            sdo:name "categorial collection of method"
        ] ,
        [
            a sh:PropertyShape ;
            reg:status reg:statusExperimental ;
            rdfs:isDefinedBy tern-shapes: ;
            skos:prefLabel "parameter of method" ;
            sh:description "The parameters of the method." ;
            sh:message "If present, `tern:hasParameter` predicates on a `tern:Method` _MUST_ have values that are `skos:Concept` nodes or string literals." ;
            sh:name "tern:hasParameter" ;
            sh:or (
                    [
                        sh:class skos:Concept
                    ]
                    [
                        sh:nodeKind sh:Literal
                    ]
                ) ;
            sh:path tern:hasParameter ;
            sdo:description "The parameters of the method." ;
            sdo:name "parameter of method"
        ] ,
        [
            a sh:PropertyShape ;
            reg:status reg:statusStable ;
            rdfs:isDefinedBy tern-shapes: ;
            skos:prefLabel "digital camera preferred label" ;
            sh:description "The source of the method." ;
            sh:message "A `tern:Method` _MUST_ have at least 1 `dcterms:source` predicate with a string or URI value." ;
            sh:minCount 1 ;
            sh:name "dcterms:source" ;
            sh:or (
                    [
                        sh:nodeKind sh:Literal
                    ]
                    [
                        sh:datatype xsd:anyURI
                    ]
                ) ;
            sh:path dcterms:source ;
            sdo:description "The source of the method." ;
            sdo:name "digital camera preferred label"
        ] ,
        [
            a sh:PropertyShape ;
            reg:status reg:statusStable ;
            rdfs:isDefinedBy tern-shapes: ;
            skos:prefLabel "method instructions" ;
            sh:description "The instructions for the method." ;
            sh:maxCount 1 ;
            sh:message "A `tern:Method` _MAY_ have at most 1 `tern:instructions` predicate with either an `rdf:Seq` value or an `rdf:HTML` or string literal." ;
            sh:name "tern:instructions" ;
            sh:or (
                    [
                        sh:class rdf:Seq
                    ]
                    [
                        sh:datatype rdf:HTML
                    ]
                    [
                        sh:nodeKind sh:Literal
                    ]
                ) ;
            sh:path tern:instructions ;
            sdo:description "The instructions for the method." ;
            sdo:name "method instructions"
        ] ,
        [
            a sh:PropertyShape ;
            reg:status reg:statusStable ;
            rdfs:isDefinedBy tern-shapes: ;
            skos:prefLabel "method definition" ;
            sh:description "The definition of the method." ;
            sh:maxCount 1 ;
            sh:message "A `tern:Method` _MAY_ have at most 1 `skos:definition` predicate with a string value." ;
            sh:name "skos:definition" ;
            sh:nodeKind sh:Literal ;
            sh:path skos:definition ;
            sdo:description "The definition of the method." ;
            sdo:name "method definition"
        ] ,
        [
            a sh:PropertyShape ;
            reg:status reg:statusStable ;
            rdfs:isDefinedBy tern-shapes: ;
            skos:prefLabel "method description" ;
            sh:description "A description of the method." ;
            sh:message "If present, `dcterms:description` predicates on a `tern:Method` _MUST_ have string or HTML literal values." ;
            sh:name "dcterms:description" ;
            sh:or (
                    [
                        sh:nodeKind sh:Literal
                    ]
                    [
                        sh:datatype rdf:HTML
                    ]
                ) ;
            sh:path dcterms:description ;
            sdo:description "A description of the method." ;
            sdo:name "method description"
        ] ,
        [
            a sh:PropertyShape ;
            reg:status reg:statusStable ;
            rdfs:isDefinedBy tern-shapes: ;
            skos:prefLabel "method additional documentation" ;
            sh:description "Links to additional online resources related to the method." ;
            sh:message "If present, `tern:additionalDocumentation` predicates on a `tern:Method` _MUST_ have values that are IRIs, `xsd:anyURI` literals, or string literals." ;
            sh:name "tern:additionalDocumentation" ;
            sh:or (
                    [
                        sh:nodeKind sh:IRI
                    ]
                    [
                        sh:datatype xsd:anyURI
                    ]
                    [
                        sh:nodeKind sh:Literal
                    ]
                ) ;
            sh:path tern:additionalDocumentation ;
            sdo:description "Links to additional online resources related to the method." ;
            sdo:name "method additional documentation"
        ] ,
        [
            a sh:PropertyShape ;
            reg:status reg:statusStable ;
            rdfs:isDefinedBy tern-shapes: ;
            skos:prefLabel "method equipment" ;
            sh:description "The equipment used for the method." ;
            sh:maxCount 1 ;
            sh:message "A `tern:Method` _MAY_ have at most 1 `tern:equipment` predicate with a value of type `skos:Concept`, string literal, or HTML literal." ;
            sh:name "tern:equipment" ;
            sh:or (
                    [
                        sh:class skos:Concept
                    ]
                    [
                        sh:nodeKind sh:Literal
                    ]
                    [
                        sh:datatype rdf:HTML
                    ]
                ) ;
            sh:path tern:equipment ;
            sdo:description "The equipment used for the method." ;
            sdo:name "method equipment"
        ] ,
        [
            a sh:PropertyShape ;
            reg:status reg:statusStable ;
            rdfs:isDefinedBy tern-shapes: ;
            skos:prefLabel "method purpose" ;
            sh:description "The purpose of the method." ;
            sh:maxCount 1 ;
            sh:message "A `tern:Method` _MAY_ have at most 1 `tern:purpose` predicate with a string value." ;
            sh:name "tern:purpose" ;
            sh:nodeKind sh:Literal ;
            sh:path tern:purpose ;
            sdo:description "The purpose of the method." ;
            sdo:name "method purpose"
        ] ,
        [
            a sh:PropertyShape ;
            reg:status reg:statusStable ;
            rdfs:isDefinedBy tern-shapes: ;
            skos:prefLabel "method scope" ;
            sh:description "The scope of the method." ;
            sh:maxCount 1 ;
            sh:message "A `tern:Method` _MAY_ have at most 1 `tern:scope` predicate with a string value." ;
            sh:name "tern:scope" ;
            sh:nodeKind sh:Literal ;
            sh:path tern:scope ;
            sdo:description "The scope of the method." ;
            sdo:name "method scope"
        ] ,
        [
            a sh:PropertyShape ;
            reg:status reg:statusStable ;
            rdfs:isDefinedBy tern-shapes: ;
            skos:prefLabel "method preferred label" ;
            sh:description "The preferred label of the method." ;
            sh:maxCount 1 ;
            sh:message "A `tern:Method` _MUST_ have exactly 1 `skos:prefLabel` predicate with a string value." ;
            sh:minCount 1 ;
            sh:name "skos:prefLabel" ;
            sh:nodeKind sh:Literal ;
            sh:path skos:prefLabel ;
            sdo:description "The preferred label of the method." ;
            sdo:name "method preferred label"
        ] ,
        tern-shapes:dcat-version ,
        tern-shapes:tern-undertakenAfter ,
        tern-shapes:tern-undertakenBefore ,
        tern-shapes:tern-undertakenComplementarily ,
        tern-shapes:tern-undertakenConcurrently ;
    sh:targetClass tern:Method ;
    sdo:description "A Method describes in detailed steps how a workflow, protocol, plan or algorithm is carried out to make an Observation or a Sample. It explains the steps to be carried out to arrive at reproducible Result." ;
    sdo:name "Method" ;
.

tern-shapes:ObservableProperty
    a sh:NodeShape ;
    rdfs:label "Observable Property" ;
    reg:status reg:statusStable ;
    rdfs:isDefinedBy tern-shapes: ;
    sh:property
        [
            a sh:PropertyShape ;
            reg:status reg:statusExperimental ;
            rdfs:isDefinedBy tern-shapes: ;
            skos:prefLabel "local value of observable property" ;
            sh:class skos:Concept ;
            sh:description "The local value of the observable property." ;
            sh:maxCount 1 ;
            sh:message "A `tern:ObservableProperty` _MAY_ have at most 1 `tern:localValue` predicate with a value of type `skos:Concept`." ;
            sh:name "tern:localValue" ;
            sh:path tern:localValue ;
            sdo:description "The local value of the observable property." ;
            sdo:name "local value of observable property"
        ] ,
        [
            a sh:PropertyShape ;
            reg:status reg:statusExperimental ;
            rdfs:isDefinedBy tern-shapes: ;
            skos:prefLabel "value of observable property" ;
            sh:class tern:Parameter ;
            sh:description "The parameter value of the observable property." ;
            sh:maxCount 1 ;
            sh:message "A `tern:ObservableProperty` _MUST_ have exactly 1 `rdf:value` predicate with a value of type `tern:Parameter`." ;
            sh:minCount 1 ;
            sh:name "rdf:value" ;
            sh:path rdf:value ;
            sdo:description "The parameter value of the observable property." ;
            sdo:name "value of observable property"
        ] ,
        [
            a sh:PropertyShape ;
            reg:status reg:statusExperimental ;
            rdfs:isDefinedBy tern-shapes: ;
            skos:prefLabel "local vocabulary of observable property" ;
            sh:description "The local vocabulary of the observable property." ;
            sh:maxCount 1 ;
            sh:message "A `tern:ObservableProperty` _MAY_ have at most 1 `tern:localVocabulary` predicate with a value of type `skos:ConceptScheme`, `skos:Collection`, or `owl:Ontology`." ;
            sh:name "tern:localVocabulary" ;
            sh:or (
                    [
                        sh:class skos:ConceptScheme
                    ]
                    [
                        sh:class skos:Collection
                    ]
                    [
                        sh:class owl:Ontology
                    ]
                ) ;
            sh:path tern:localVocabulary ;
            sdo:description "The local vocabulary of the observable property." ;
            sdo:name "local vocabulary of observable property"
        ] ,
        [
            a sh:PropertyShape ;
            reg:status reg:statusExperimental ;
            rdfs:isDefinedBy tern-shapes: ;
            skos:prefLabel "vocabulary of observable property" ;
            sh:description "The vocabulary of the observable property." ;
            sh:maxCount 1 ;
            sh:message "A `tern:ObservableProperty` _MUST_ have exactly 1 `tern:vocabulary` predicate with a value of type `skos:ConceptScheme`, `skos:Collection`, or `owl:Ontology`." ;
            sh:minCount 1 ;
            sh:name "tern:vocabulary" ;
            sh:or (
                    [
                        sh:class skos:ConceptScheme
                    ]
                    [
                        sh:class skos:Collection
                    ]
                    [
                        sh:class owl:Ontology
                    ]
                ) ;
            sh:path tern:vocabulary ;
            sdo:description "The vocabulary of the observable property." ;
            sdo:name "vocabulary of observable property"
        ] ;
    sh:targetClass tern:ObservableProperty ;
    sdo:description "An observable quality (property, characteristic) of a [FeatureOfInterest](http://w3.org/ns/sosa/FeatureOfInterest). A feature-of-interest refers to a feature whose properties are measured or observed. " ;
    sdo:name "Observable Property" ;
.

tern-shapes:Observation
    a sh:NodeShape ;
    rdfs:label "Observation" ;
    rdfs:isDefinedBy tern-shapes: ;
    sh:property
        tern-shapes:Observation-hasResult ,
        tern-shapes:dcterms-identifier ,
        tern-shapes:dcterms-type ,
        tern-shapes:geo-hasGeometry ,
        tern-shapes:prov-qualifiedAssociation ,
        tern-shapes:prov-wasAssociatedWith ,
        tern-shapes:rdfs-comment ,
        tern-shapes:sdo-spatial ,
        tern-shapes:sosa-hasFeatureOfInterest ,
        tern-shapes:sosa-hasSimpleResult ,
        tern-shapes:sosa-madeBySensor ,
        tern-shapes:sosa-observedProperty ,
        tern-shapes:sosa-phenomenonTime ,
        tern-shapes:sosa-resultTime ,
        tern-shapes:sosa-usedProcedure ,
        tern-shapes:tern-hasAttribute ,
        tern-shapes:tern-hasSiteVisit ,
        tern-shapes:tern-observationType ,
        tern-shapes:void-inDataset ;
    sh:targetClass tern:Observation ;
    sdo:description "Act of carrying out an (`Observation`) `Procedure` to estimate or calculate a value of a property of a `FeatureOfInterest`. Links to a `Sensor` to describe what made the `Observation` and how; links to an `ObservableProperty` to describe what the result is an estimate of, and to a `FeatureOfInterest` to detail what that property was associated with." ;
    sdo:name "Observation" ;
.

tern-shapes:ObservationCollection
    a sh:NodeShape ;
    rdfs:label "Observation collection" ;
    rdfs:isDefinedBy tern-shapes: ;
    sh:property
        tern-shapes:ObservationCollection-hasFeatureOfInterest ,
        tern-shapes:ObservationCollection-hasMember ,
        tern-shapes:ObservationCollection-hasSiteVisit ,
        tern-shapes:ObservationCollection-hasUltimateFeatureOfInterest ,
        tern-shapes:ObservationCollection-madeBySensor ,
        tern-shapes:ObservationCollection-observedProperty ,
        tern-shapes:ObservationCollection-phenomenonTime ,
        tern-shapes:ObservationCollection-resultTime ,
        tern-shapes:ObservationCollection-usedProcedure ,
        tern-shapes:dcterms-identifier ,
        tern-shapes:geo-hasGeometry ,
        tern-shapes:prov-wasAssociatedWith ,
        tern-shapes:sosa-isObservedBy ,
        tern-shapes:tern-hasAttribute ,
        tern-shapes:void-inDataset ;
    sh:targetClass tern:ObservationCollection ;
    sdo:description "Collection of one or more observations, whose members share a common value for one or more property" ;
    sdo:name "Observation collection" ;
.

tern-shapes:Platform
    a sh:NodeShape ;
    rdfs:label "Platform" ;
    rdfs:isDefinedBy tern-shapes: ;
    sh:property
        tern-shapes:dcterms-description ,
        tern-shapes:geo-hasGeometry ,
        tern-shapes:sdo-spatial ,
        tern-shapes:tern-climateCode ,
        tern-shapes:tern-dateCommissioned ,
        tern-shapes:tern-dateDecommissioned ,
        tern-shapes:tern-platformType ,
        tern-shapes:tern-purpose ;
    sh:targetClass tern:Platform ;
    sdo:description "An entity that hosts other entities, particularly Sensors, Samplers, and other Platforms." ;
    sdo:name "Platform" ;
.

tern-shapes:Procedure
    a sh:NodeShape ;
    rdfs:label "Procedure" ;
    reg:status reg:statusStable ;
    rdfs:isDefinedBy tern-shapes: ;
    sh:message "A `tern:Procedure` _MUST_ identify its method with either an `rdf:value` predicate or a `tern:hasMethod` predicate." ;
    sh:or (
            [
                sh:property [
                        a sh:PropertyShape ;
                        rdfs:isDefinedBy tern-shapes: ;
                        skos:prefLabel "value of procedure" ;
                        sh:description "The method value of the procedure." ;
                        sh:message "A `tern:Procedure` _MUST_ have at least 1 `rdf:value` predicate when no `tern:hasMethod` predicate is present." ;
                        sh:minCount 1 ;
                        sh:name "rdf:value" ;
                        sh:path rdf:value ;
                        sdo:description "The method value of the procedure." ;
                        sdo:name "value of procedure"
                    ]
            ]
            [
                sh:property [
                        a sh:PropertyShape ;
                        rdfs:isDefinedBy tern-shapes: ;
                        skos:prefLabel "method of procedure" ;
                        sh:description "The method of the procedure." ;
                        sh:message "A `tern:Procedure` _MUST_ have at least 1 `tern:hasMethod` predicate when no `rdf:value` predicate is present." ;
                        sh:minCount 1 ;
                        sh:name "tern:hasMethod" ;
                        sh:path tern:hasMethod ;
                        sdo:description "The method of the procedure." ;
                        sdo:name "method of procedure"
                    ]
            ]
        ) ;
    sh:property
        [
            a sh:PropertyShape ;
            reg:status reg:statusExperimental ;
            rdfs:isDefinedBy tern-shapes: ;
            skos:prefLabel "vocabulary of procedure" ;
            sh:description "The vocabulary of the procedure." ;
            sh:maxCount 1 ;
            sh:message "A `tern:Procedure` _MUST_ have exactly 1 `tern:vocabulary` predicate." ;
            sh:minCount 1 ;
            sh:name "tern:vocabulary" ;
            sh:path tern:vocabulary ;
            sdo:description "The vocabulary of the procedure." ;
            sdo:name "vocabulary of procedure"
        ] ,
        [
            a sh:PropertyShape ;
            reg:status reg:statusExperimental ;
            rdfs:isDefinedBy tern-shapes: ;
            skos:prefLabel "procedure has input" ;
            sh:class tern:Input ;
            sh:description "The input of the procedure." ;
            sh:maxCount 1 ;
            sh:message "A `tern:Procedure` _MAY_ have at most 1 `ssn:hasInput` predicate with a value of type `tern:Input`." ;
            sh:name "ssn:hasInput" ;
            sh:path ssn:hasInput ;
            sdo:description "The input of the procedure." ;
            sdo:name "procedure has input"
        ] ,
        [
            a sh:PropertyShape ;
            reg:status reg:statusExperimental ;
            rdfs:isDefinedBy tern-shapes: ;
            skos:prefLabel "value of procedure" ;
            sh:description "The method value of the procedure, given as the IRI of a `tern:Method`. The type of the method is not required in the data, because the method is usually defined in a separate vocabulary." ;
            sh:maxCount 1 ;
            sh:message "A `tern:Procedure` _MAY_ have a maximum of 1 `rdf:value` predicate where the value node is an IRI." ;
            sh:name "rdf:value" ;
            sh:nodeKind sh:IRI ;
            sh:path rdf:value ;
            sdo:description "The method value of the procedure, given as the IRI of a `tern:Method`. The type of the method is not required in the data, because the method is usually defined in a separate vocabulary." ;
            sdo:name "value of procedure"
        ] ,
        [
            a sh:PropertyShape ;
            reg:status reg:statusExperimental ;
            rdfs:isDefinedBy tern-shapes: ;
            skos:prefLabel "method of procedure" ;
            sh:description "The method of the procedure, given as the IRI of a `tern:Method`. The type of the method is not required in the data, because the method is usually defined in a separate vocabulary." ;
            sh:maxCount 1 ;
            sh:message "A `tern:Procedure` _MAY_ have a maximum of 1 `tern:hasMethod` predicate where the value node is an IRI." ;
            sh:name "tern:hasMethod" ;
            sh:nodeKind sh:IRI ;
            sh:path tern:hasMethod ;
            sdo:description "The method of the procedure, given as the IRI of a `tern:Method`. The type of the method is not required in the data, because the method is usually defined in a separate vocabulary." ;
            sdo:name "method of procedure"
        ] ,
        tern-shapes:Procedure-startedAtTime ,
        tern-shapes:geo-hasGeometry ,
        tern-shapes:prov-endedAtTime ,
        tern-shapes:prov-wasAssociatedWith ,
        tern-shapes:tern-hasAttribute ,
        tern-shapes:tern-hasSurvey ,
        tern-shapes:void-inDataset ;
    sh:targetClass tern:Procedure ;
    sdo:description "A workflow, protocol, plan, algorithm, or computational method specifying how to make an Observation, create a Sample, or make a change to the state of the world (via an [Actuator](http://w3.org/ns/sosa/Actuator). A Procedure is re-usable, and might be involved in many Observation, Sampling, or [Actuations](http://w3.org/ns/sosa/Actuation). it explains the steps to be carried out to arrive at a reproducible Result." ;
    sdo:name "Procedure" ;
.

tern-shapes:RDFDataset
    a sh:NodeShape ;
