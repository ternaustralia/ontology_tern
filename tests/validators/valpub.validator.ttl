<https://linked.data.gov.au/def/ontpub/req/2.1.9g>
    a sh:NodeShape ;
    rdfs:isDefinedBy ont: ;
    sh:property
        [
            a sh:PropertyShape ;
            rdfs:isDefinedBy ont: ;
            sh:message "Requirement 2.1.9g: Whenever prov:wasDerivedFrom is used, it must be an object property indicating an IRI" ;
            sh:nodeKind sh:IRI ;
