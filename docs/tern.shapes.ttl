        tern-shapes:RDFDataset-title ,
        tern-shapes:RDFDataset-vocabulary ,
        tern-shapes:dcterms-description ,
        tern-shapes:tern-hasAttribute ;
    sh:targetClass tern:RDFDataset ;
    sdo:description "A set of RDF triples that are published, maintained or aggregated by a single provider." ;
